set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL080YU484C8G
set_global_assignment -name TOP_LEVEL_ENTITY nes_top
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF

# nes_sim.sv pulls in the CPU/APU/PPU through `include "cpu/...", "ppu/..." relative to src/
set_global_assignment -name SEARCH_PATH ../../src
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/nes_sim.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/sd_card/sd_card.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/cartridge/cartridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/vga/nes_vga.sv
set_global_assignment -name SYSTEMVERILOG_FILE nes_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE nes_top.sv
set_global_assignment -name SDC_FILE nes.sdc

set_location_assignment PIN_G1 -to CLOCK_50
set_location_assignment PIN_P3 -to RESET_N
set_location_assignment PIN_Y4 -to LEDR
set_location_assignment PIN_V5 -to LED2

# SD-card socket. In SPI mode SD_D3 is chip-select.
set_location_assignment PIN_U19 -to SD_DAT0
set_location_assignment PIN_W19 -to SD_CMD
set_location_assignment PIN_W20 -to SD_CLK
set_location_assignment PIN_W17 -to SD_CS_N
set_location_assignment PIN_T18 -to SD_CD

# Pmod VGA on J11: pins 1-4 red, pins 7-10 blue.
set_location_assignment PIN_R1 -to VGA_R[0]
set_location_assignment PIN_P1 -to VGA_R[1]
set_location_assignment PIN_N1 -to VGA_R[2]
set_location_assignment PIN_M1 -to VGA_R[3]
set_location_assignment PIN_R2 -to VGA_B[0]
set_location_assignment PIN_P2 -to VGA_B[1]
set_location_assignment PIN_N2 -to VGA_B[2]
set_location_assignment PIN_M2 -to VGA_B[3]

# Pmod VGA on J10: pins 1-4 green, pin 7 HS, pin 8 VS.
set_location_assignment PIN_J2 -to VGA_G[0]
set_location_assignment PIN_H2 -to VGA_G[1]
set_location_assignment PIN_P5 -to VGA_G[2]
set_location_assignment PIN_M5 -to VGA_G[3]
set_location_assignment PIN_J1 -to VGA_HS
set_location_assignment PIN_H1 -to VGA_VS

set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top