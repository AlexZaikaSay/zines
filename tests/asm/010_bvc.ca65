data_segment = $200  
code_segment = $400  

        .DATA
        .org data_segment
        _ff:  .res    1,$ff 
        _00:  .res    1,$00 

        .CODE
        .org code_segment

start:  bit _ff
        bvc nb_
        clv
        bvc b_
        nop
nb_:    nop
b_:     nop
        jmp up
b_2_:   jmp long

up:     ; simple up
        bit _ff
        bvc nb_
        clv
        bvc b_2_

.repeat 220
        nop
.endrepeat

long:   ; down page cross
        bit _ff
        bvc nb_long_
        clv
        bvc b_long_

back:
        bvc back

.repeat 20
        nop
.endrepeat

nb_long_:
        nop
b_long_:
        bvc back
        