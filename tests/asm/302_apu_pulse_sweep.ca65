zero_page    = $00
data_segment = $200
code_segment = $400
vect_segment = $fffa

        .ZEROPAGE
        .org zero_page

        .DATA
        .org data_segment

        .CODE
        .org code_segment

APU_PULSE1_CTRL  = $4000
APU_PULSE1_SWEEP = $4001
APU_PULSE1_FREQ1 = $4002
APU_PULSE1_FREQ2 = $4003
APU_STATUS       = $4015
APU_FRAME_CTRL   = $4017

NOTE_A4_PERIOD   = $00FD
NOTE_D6_PERIOD   = $005D
LEN_8TH          = %00010000  ; length-table index 2 = 20 half-frames

SWEEP_POSITIVE   = %10010001  ; enabled, divider period 1, positive, shift 1
SWEEP_NEGATIVE   = %10011001  ; enabled, divider period 1, negative, shift 1

start:
        sei
        cld
        ldx #$FF
        txs

        lda #$40
        sta APU_FRAME_CTRL
        lda #$01
        sta APU_STATUS          ; enable Pulse 1

        lda #%10011111
        sta APU_PULSE1_CTRL     ; 50% duty, constant volume 15

; 1. Positive sweep, A4: timer period increases, pitch falls.
        lda #SWEEP_POSITIVE
        sta APU_PULSE1_SWEEP
        lda #<NOTE_A4_PERIOD
        sta APU_PULSE1_FREQ1
        lda #((>NOTE_A4_PERIOD) | LEN_8TH)
        sta APU_PULSE1_FREQ2
        jsr wait_note

; 2. Negative sweep, A4: timer period decreases, pitch rises.
        lda #SWEEP_NEGATIVE
        sta APU_PULSE1_SWEEP
        lda #<NOTE_A4_PERIOD
        sta APU_PULSE1_FREQ1
        lda #((>NOTE_A4_PERIOD) | LEN_8TH)
        sta APU_PULSE1_FREQ2
        jsr wait_note

; 3. Positive sweep, D6: timer period increases, pitch falls.
        lda #SWEEP_POSITIVE
        sta APU_PULSE1_SWEEP
        lda #<NOTE_D6_PERIOD
        sta APU_PULSE1_FREQ1
        lda #((>NOTE_D6_PERIOD) | LEN_8TH)
        sta APU_PULSE1_FREQ2
        jsr wait_note

; 4. Negative sweep, D6: timer period decreases, pitch rises.
        lda #SWEEP_NEGATIVE
        sta APU_PULSE1_SWEEP
        lda #<NOTE_D6_PERIOD
        sta APU_PULSE1_FREQ1
        lda #((>NOTE_D6_PERIOD) | LEN_8TH)
        sta APU_PULSE1_FREQ2
        jsr wait_note

; 5. Negative sweep, D6: timer period decreases, pitch rises.
        lda #SWEEP_NEGATIVE
        sta APU_PULSE1_SWEEP
        lda #<NOTE_D6_PERIOD
        sta APU_PULSE1_FREQ1
        lda #((>NOTE_D6_PERIOD) | LEN_8TH)
        sta APU_PULSE1_FREQ2
        jsr wait_note
done:
        jmp done

; Wait for the hardware length counter to expire. No software delay loop
; is used to time the sound; the APU length counter controls its duration.
wait_note:
        lda APU_STATUS
        and #$01
        bne wait_note
        rts

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   start
        .word   $0000
