data_segment = $200
code_segment = $400
vect_segment = $fffa

        .DATA
        .org data_segment
        var1:  .byte    12 
        var2:  .byte    13 
        var3:  .byte    14

        .CODE
        .org code_segment
start:  lda var1
        ldx var2
        ldy var3
        nop

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   $0000
        .word   $0000
