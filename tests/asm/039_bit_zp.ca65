zero_page    = $00
data_segment = $200
code_segment = $400
vect_segment = $fffa

        .ZEROPAGE
        .org zero_page
        _ff:  .byte   $ff 
        _00:  .byte   $00 

        .DATA
        .org data_segment

        .CODE
        .org code_segment
start:  lda #$00
        bit _ff
        lda #$01
        bit _ff
        lda #$00
        bit _00
        lda #$01
        bit _00
        nop

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   $0000
        .word   $0000
