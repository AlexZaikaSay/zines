zero_page    = $00
data_segment = $200
code_segment = $400
vect_segment = $fffa

        .ZEROPAGE
        .org zero_page

        .DATA
        .org data_segment

        .CODE
        .org code_segment

APU_PULSE1_CTRL =  $4000
APU_PULSE1_FREQ1 = $4002
APU_PULSE1_FREQ2 = $4003

APU_STATUS       = $4015
APU_FRAME_CTRL   = $4017

NOTE_A4_PERIOD   = $019C    ; A4 (440 Hz)
NOTE_D6_PERIOD   = $0094    ; D6 (1190 Hz)

; 1/8
; Index $02 in 5 hi bits of $4003. 
LEN_8TH        = %00010000 

; Whole note
; Index $02 in 5 hi bits of $4003. 
LEN_WHOLE      = %00100000 

start:  



; NES 6502 / ca65
; Pulse 1: A4, D6 hardware-timed notes and silence
; $4000: 50% duty, constant volume, Length Counter enabled

        sei
        cld
        ldx #$FF
        txs
        
        lda #$40
        sta APU_FRAME_CTRL
        lda #$01
        sta APU_STATUS          ; enable Pulse 1

        ; duty 50% (%10), fixed volume (%1), volume 15 (%1111)
        ; NOTE: bit pulse1_halt = 1! Len Counter works.
        lda #%10111111
        sta APU_PULSE1_CTRL
        
        lda #<NOTE_A4_PERIOD
        sta APU_PULSE1_FREQ1 

        lda #((>NOTE_A4_PERIOD) | LEN_8TH)
        sta APU_PULSE1_FREQ2    ; Sound is ON, counter LEN counds down!

        jsr wait


        ; duty 50% (%10), fixed volume (%1), volume 15 (%1111)
        ; NOTE: bit pulse1_halt = 1! Len Counter works.
        lda #%10111111
        sta APU_PULSE1_CTRL

        lda #<NOTE_D6_PERIOD
        sta APU_PULSE1_FREQ1 

        lda #((>NOTE_D6_PERIOD) | LEN_8TH)
        sta APU_PULSE1_FREQ2    ; Sound is ON, counter LEN counds down!

        jsr wait

        ; duty 50% (%10), envelope volume (%0), decay 3 (%0011)
        ; NOTE: bit pulse1_halt = 1! Len Counter works.
        lda #%10100011
        sta APU_PULSE1_CTRL
        
        lda #<NOTE_A4_PERIOD
        sta APU_PULSE1_FREQ1 

        lda #((>NOTE_A4_PERIOD) | LEN_WHOLE)
        sta APU_PULSE1_FREQ2    ; Sound is ON, counter LEN counds down!

        jsr wait

        ; duty 50% (%10), envelope volume (%0), volume 15 (%1111)
        ; NOTE: bit pulse1_halt = 0! Len Forewer.
        lda #%10100011
        sta APU_PULSE1_CTRL
        
        lda #<NOTE_D6_PERIOD
        sta APU_PULSE1_FREQ1 

        lda #((>NOTE_D6_PERIOD) | LEN_WHOLE)
        sta APU_PULSE1_FREQ2    ; Sound is ON, counter LEN counds down!


loop:
        jmp loop

wait:
        lda APU_STATUS
        and #$01                ; Check bit 0 (if Pulse 1 is active?)
        bne wait   
        rts

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   start
        .word   $0000
