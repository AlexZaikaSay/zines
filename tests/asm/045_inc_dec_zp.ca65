zero_page    = $00
data_segment = $200
code_segment = $400
vect_segment = $fffa

        .ZEROPAGE
        .org zero_page
_aa:    .byte   $aa

        .DATA
        .org data_segment

        .CODE
        .org code_segment
start:
        inc _aa
        dec _aa
        nop

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   $0000
        .word   $0000
