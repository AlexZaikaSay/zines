data_segment = $200
code_segment = $400
vect_segment = $fffa

        .DATA
        .org data_segment
        var:  .byte     0 

        .CODE
        .org code_segment
start:  lda #$15
        sta var
        ldx #$16
        stx var
        ldy #$17
        sty var
        nop

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   $0000
        .word   $0000
