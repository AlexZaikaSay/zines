zero_page    = $00
data_segment = $200
code_segment = $400
vect_segment = $fffa

        .ZEROPAGE
        .org zero_page
        _aa:  .res    1,$aa 
        _55:  .res    1,$55 

        .DATA
        .org data_segment

        .CODE
        .org code_segment

start:  
        lda #$55
        ldx #$0
        cmp _aa,x
        ldx #$1
        cmp _aa,x

        nop

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   $0000
        .word   $0000
