data_segment = $200
code_segment = $400
vect_segment = $fffa

        .DATA
        .org data_segment

        .CODE
        .org code_segment
start:  lda #0
        bne ne_
        lda #1
        bne eq_
        nop
ne_:    nop
eq_:    nop
        jmp up
eq_2:   jmp long

up:     ; simple up
        lda #0
        bne ne_
        lda #1
        bne eq_2

.repeat 220
        nop
.endrepeat

long:   ; down page cross
        lda #0
        bne ne_long
        lda #1
        bne eq_long

back:
        bne back

.repeat 20
        nop
.endrepeat

ne_long:
        nop
eq_long:
        bne back

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   $0000
        .word   $0000
        