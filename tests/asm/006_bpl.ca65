
        .CODE
        ; simple down
start:  lda #$ff
        bpl nb_
        lda #0
        bpl b_
        nop
nb_:    nop
b_:     nop
        jmp up
b_2_:   jmp long

up:     ; simple up
        lda #$ff
        bpl nb_
        lda #0
        bpl b_2_

.repeat 220
        nop
.endrepeat

long:   ; down page cross
        lda #$ff
        bpl nb_long_
        lda #0
        bpl b_long_

back:
        bpl back

.repeat 20
        nop
.endrepeat

nb_long_:
        nop
b_long_:
        bpl back
        