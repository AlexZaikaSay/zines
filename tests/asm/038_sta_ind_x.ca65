zero_page    = $00
data_segment = $200
code_segment = $400
vect_segment = $fffa

        .ZEROPAGE
        .org zero_page
        var1:  .byte   0 
        var2:  .word   var5
        var3:  .word   var6

        .DATA
        .org data_segment
        var4:  .byte    0 
        var5:  .byte    0 
        var6:  .byte    0


        .CODE
        .org code_segment
start:  
        lda #$15
        ldx #$3
        sta (var1,x)

        nop

        .segment "VECTORS"
        .org vect_segment
        .word   $0000
        .word   $0000
        .word   $0000
