set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL080YU484C8G
set_global_assignment -name TOP_LEVEL_ENTITY nes_top
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF

# ---- Video output selection ----
# Uncomment for HDMI (video + audio) on the board's HDMI connector;
# leave commented for VGA on the Pmod VGA (no audio).
set_global_assignment -name VERILOG_MACRO "VIDEO_HDMI=1"

# RTL from filelists/{common,cpu6502,nes_core,cart,storage,display,input,audio}.f; never add sim/
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/zines_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/sync_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu6502/alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu6502/ff.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu6502/int_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu6502/main_fsm.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu6502/mos6502.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu6502/mux3_1.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu6502/mux5_1.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu6502/mux9_1.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/apu/apu_frame_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/apu/apu_noise.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/apu/apu_pulse.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/apu/apu_triangle.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/apu/apu2A03.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/cpu2a03/cpu2A03.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/ppu/palette_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/ppu/ppu2C02.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/nes_core/nes.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/storage/sd/sd_card.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/storage/sd/disk.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/storage/sd/sd_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cart/cartridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/input/nes_pad_poller.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/input/nes_pad_port.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/display/charmap.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/display/vga.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/display/nes_vga.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/display/tmds_video_encoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/display/hdmi_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/audio/nes_audio_sampler.sv

set_global_assignment -name SYSTEMVERILOG_FILE hdmi_serializer.sv
set_global_assignment -name SYSTEMVERILOG_FILE nes_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE nes_top.sv
set_global_assignment -name SDC_FILE nes.sdc

set_location_assignment PIN_G1 -to CLOCK_50
set_location_assignment PIN_P3 -to RESET_N
set_location_assignment PIN_Y4 -to LEDR
set_location_assignment PIN_V5 -to LED2

# SD-card socket. In SPI mode SD_D3 is chip-select.
set_location_assignment PIN_U19 -to SD_DAT0
set_location_assignment PIN_W19 -to SD_CMD
set_location_assignment PIN_W20 -to SD_CLK
set_location_assignment PIN_W17 -to SD_CS_N
set_location_assignment PIN_T18 -to SD_CD

# NES controller, player 1. DO is active low (pressed = 0); the pull-up makes an
# unplugged pad read "not pressed".
set_location_assignment PIN_M20 -to JOY_LATCH
set_location_assignment PIN_M19 -to JOY_CLK
set_location_assignment PIN_L22 -to JOY_DATA
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to JOY_DATA

# 3-digit 7-segment display (debug), same pins as cartridge_demo
set_location_assignment PIN_U14 -to SMG_Data[7]
set_location_assignment PIN_AA19 -to SMG_Data[6]
set_location_assignment PIN_V15 -to SMG_Data[5]
set_location_assignment PIN_U12 -to SMG_Data[4]
set_location_assignment PIN_V13 -to SMG_Data[3]
set_location_assignment PIN_AB18 -to SMG_Data[2]
set_location_assignment PIN_AB19 -to SMG_Data[1]
set_location_assignment PIN_W14 -to SMG_Data[0]
set_location_assignment PIN_U11 -to Scan_Sig[2]
set_location_assignment PIN_V16 -to Scan_Sig[1]
set_location_assignment PIN_AA18 -to Scan_Sig[0]

# Pmod VGA on J11: pins 1-4 red, pins 7-10 blue.
set_location_assignment PIN_R1 -to VGA_R[0]
set_location_assignment PIN_P1 -to VGA_R[1]
set_location_assignment PIN_N1 -to VGA_R[2]
set_location_assignment PIN_M1 -to VGA_R[3]
set_location_assignment PIN_R2 -to VGA_B[0]
set_location_assignment PIN_P2 -to VGA_B[1]
set_location_assignment PIN_N2 -to VGA_B[2]
set_location_assignment PIN_M2 -to VGA_B[3]

# Pmod VGA on J10: pins 1-4 green, pin 7 HS, pin 8 VS.
set_location_assignment PIN_J2 -to VGA_G[0]
set_location_assignment PIN_H2 -to VGA_G[1]
set_location_assignment PIN_P5 -to VGA_G[2]
set_location_assignment PIN_M5 -to VGA_G[3]
set_location_assignment PIN_J1 -to VGA_HS
set_location_assignment PIN_H1 -to VGA_VS

# HDMI connector (V3 schematic: FPGA -> TPD12S016 ESD -> connector, no resistors).
# All banks are 3.3 V and bank 4 also holds the SD card, so LVDS_E_3R (2.5 V) is not
# possible; each pair is two complementary 3.3-V LVTTL outputs (default standard).
# In the VGA build these ports do not exist and Quartus only warns about them.
set_location_assignment PIN_AA20 -to TMDS[2]
set_location_assignment PIN_AB20 -to TMDS_N[2]
set_location_assignment PIN_AA16 -to TMDS[1]
set_location_assignment PIN_AB16 -to TMDS_N[1]
set_location_assignment PIN_AA15 -to TMDS[0]
set_location_assignment PIN_AB15 -to TMDS_N[0]
set_location_assignment PIN_AA14 -to TMDS_CLK
set_location_assignment PIN_AB14 -to TMDS_CLK_N

set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top